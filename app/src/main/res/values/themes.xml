<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========== الثيم الأساسي ========== -->
    <style name="Theme.DietSystem" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#81C784</item>
        <item name="colorSecondaryVariant">#388E3C</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">#F5F5F5</item>
        <item name="android:statusBarColor">#2E7D32</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#2E7D32</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <!-- ========== أنيميشن الانتقال ========== -->
    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <!-- ========== Style للكاردات ========== -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="strokeColor">#2E7D32</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ========== Style للعنوان الرئيسي ========== -->
    <style name="TitleMain">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2E7D32</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ========== Style لعناوين الكاردات ========== -->
    <style name="TitleCard">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#1A237E</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- ========== Style للـ TextView العادية ========== -->
    <style name="TextNormal">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#555555</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- ========== Style للـ Button الأساسي ========== -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#2E7D32</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- ========== Style للـ Button الثانوي ========== -->
    <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#757575</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- ========== Style لأزرار التمرير الدائرية ========== -->
    <style name="ButtonScrollCircle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">#2E7D32</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">#2E7D32</item>
    </style>

    <!-- ========== Style لأزرار اللغة والمشاركة ========== -->
    <style name="ButtonIconRound" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="strokeColor">#2E7D32</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">#2E7D32</item>
        <item name="android:backgroundTint">#FFFFFF</item>
    </style>

    <!-- ========== Style لحقول الإدخال ========== -->
    <style name="TextInputOutlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#2E7D32</item>
        <item name="hintTextColor">#2E7D32</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- ========== Style للـ Chip ========== -->
    <style name="ChipChoice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <!-- ========== Style للـ Footer ========== -->
    <style name="TextFooter">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#999999</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- ========== Style لنتيجة BMI ========== -->
    <style name="TextBmiResult">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2E7D32</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextBmiCategory">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#555555</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>